# Do not upload to GitHub: personal stuff and what gets built by itself. A leading "/" — root only
# (without it build/ would also hide claude/skills/build/).
/.claude/
/upload.bat
/_utils/.backups/
/build/
/dist/
/nemesis/client/tuning.json        # board numbers saved by the editor's Nemesis tab (editor.bat)
/nemesis/client/board-edits.json   # the parts edited on that tab: moved, turned, recoloured, deleted
# Windows keeps the game in "Nemesis/" (git stores whatever case the commit was made with): same files
/[Nn]emesis/client/tuning.json
/[Nn]emesis/client/board-edits.json
